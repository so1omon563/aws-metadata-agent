#!/usr/bin/env bash

set -eu
set -o pipefail

readonly BEGIN_MARKER='# aws-metadata-agent user mode: begin'
readonly END_MARKER='# aws-metadata-agent user mode: end'
readonly DEFAULT_HEADER='[default]'

fail() {
  printf 'aws-metadata-config: %s\n' "$1" >&2
  exit "${2:-1}"
}

marker_count() {
  local marker=$1
  local file=$2

  command awk -v marker="$marker" '
    {
      line = $0
      sub(/\r$/, "", line)
      if (line == marker) {
        count++
      }
    }
    END { print count + 0 }
  ' "$file"
}

replace_contents() {
  local destination=$1
  local source=$2
  local backup=$3
  local existed=false

  if [[ -e $destination ]]; then
    existed=true
    command cp -p "$destination" "$backup"
  else
    umask 077
    : >"$destination"
  fi

  if ! command dd if="$source" of="$destination" 2>/dev/null; then
    if [[ $existed == true ]]; then
      command dd if="$backup" of="$destination" 2>/dev/null || true
    else
      command rm -f "$destination"
    fi
    fail "unable to update $destination"
  fi
}

write_block() {
  local output=$1
  local command_path=$2
  local line_ending=${3:-lf}

  if [[ $line_ending == crlf ]]; then
    printf '%s\r\ncredential_process = "%s" _credential-process\r\n%s\r\n' \
      "$BEGIN_MARKER" "$command_path" "$END_MARKER" >"$output"
  else
    printf '%s\ncredential_process = "%s" _credential-process\n%s\n' \
      "$BEGIN_MARKER" "$command_path" "$END_MARKER" >"$output"
  fi
}

insert_block() {
  local input=$1
  local block=$2
  local output=$3

  command awk -v block="$block" '
    {
      print
      if (!inserted &&
          $0 ~ /^[[:space:]]*\[default\][[:space:]]*$/) {
        while ((getline line < block) > 0) {
          print line
        }
        close(block)
        inserted = 1
      }
    }
    END {
      if (!inserted) {
        exit 2
      }
    }
  ' "$input" >"$output" || fail 'unable to update the default AWS profile'
}

remove_block() {
  local input=$1
  local output=$2

  command awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
    {
      line = $0
      sub(/\r$/, "", line)
    }
    line == begin {
      if (skipping) {
        exit 2
      }
      skipping = 1
      next
    }
    line == end {
      if (!skipping) {
        exit 2
      }
      skipping = 0
      next
    }
    !skipping { print }
    END {
      if (skipping) {
        exit 2
      }
    }
  ' "$input" >"$output" || fail 'owned AWS config block is malformed'
}

extract_block() {
  local input=$1
  local output=$2

  command awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
    {
      line = $0
      sub(/\r$/, "", line)
    }
    line == begin { copying = 1 }
    copying { print }
    line == end { copying = 0 }
  ' "$input" >"$output"
}

default_section_count() {
  local input=$1

  grep -Ec '^[[:space:]]*\[default\][[:space:]]*$' "$input" 2>/dev/null ||
    true
}

default_has_credential_settings() {
  local input=$1

  command awk '
    /^[[:space:]]*\[/ {
      in_default = ($0 ~ /^[[:space:]]*\[default\][[:space:]]*$/)
      next
    }
    in_default {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line ~ /^[#;]/ || line !~ /=/) {
        next
      }
      key = line
      sub(/[[:space:]]*=.*/, "", key)
      key = tolower(key)
      gsub(/[[:space:]]/, "", key)
      if (key ~ /^(aws_access_key_id|aws_secret_access_key|aws_session_token|credential_process|credential_source|source_profile|role_arn|web_identity_token_file|sso_.*|login_session)$/) {
        found = 1
        exit
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$input"
}

default_credentials_has_settings() {
  local input=$1

  command awk '
    /^[[:space:]]*\[/ {
      in_default = ($0 ~ /^[[:space:]]*\[default\][[:space:]]*$/)
      next
    }
    in_default {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line !~ /^[#;]/ && line ~ /=/) {
        found = 1
        exit
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$input"
}

validate_add_target() {
  block_state=missing
  default_state=missing
  base_path=''
  [[ -e $config_path ]] || return 0

  begin_count=$(marker_count "$BEGIN_MARKER" "$config_path")
  end_count=$(marker_count "$END_MARKER" "$config_path")
  if [[ $begin_count -eq 0 && $end_count -eq 0 ]]; then
    block_state=plain
    base_path=$config_path
  else
    if [[ $begin_count -ne 1 || $end_count -ne 1 ]]; then
      fail 'AWS config has incomplete or duplicate project ownership markers'
    fi
    remove_block "$config_path" "$base_file"
    block_state=owned
    base_path=$base_file
  fi

  default_count=$(default_section_count "$base_path")
  if [[ $default_count -gt 1 ]]; then
    fail 'AWS config has duplicate default profiles'
  fi
  if [[ $default_count -eq 1 ]]; then
    default_state=present
    if default_has_credential_settings "$base_path"; then
      fail 'AWS default profile already has a credential provider'
    fi
  fi
}

command_name=${1:-}
config_path=${2:-}
command_path=${3:-}
credentials_path=''

if [[ $command_name != validate && $command_name != add &&
      $command_name != remove ]]; then
  fail 'usage: aws-metadata-config validate CONFIG [CREDENTIALS] | add CONFIG COMMAND [CREDENTIALS] | remove CONFIG' 2
fi
if [[ $command_name == validate ]]; then
  credentials_path=$command_path
  command_path=''
elif [[ $command_name == add ]]; then
  credentials_path=${4:-}
fi
if [[ $config_path != /* || $config_path == *$'\n'* ]]; then
  fail 'CONFIG must be an absolute path' 2
fi
if [[ -L $config_path && ! -e $config_path ]]; then
  fail "refusing to replace dangling symlink $config_path"
fi
if [[ -e $config_path && ! -f $config_path ]]; then
  fail "AWS config is not a regular file: $config_path"
fi
if [[ -e $config_path && ! -r $config_path ]]; then
  fail "AWS config is not readable: $config_path"
fi
if [[ -n $credentials_path ]]; then
  if [[ $credentials_path != /* || $credentials_path == *$'\n'* ]]; then
    fail 'CREDENTIALS must be an absolute path' 2
  fi
  if [[ -e $credentials_path && ! -f $credentials_path ]]; then
    fail "AWS credentials are not a regular file: $credentials_path"
  fi
  if [[ -e $credentials_path && ! -r $credentials_path ]]; then
    fail "AWS credentials are not readable: $credentials_path"
  fi
  if [[ -e $credentials_path ]] &&
     default_credentials_has_settings "$credentials_path"; then
    fail 'AWS credentials file already configures the default profile'
  fi
fi

temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/aws-metadata-config.XXXXXX")
trap 'rm -rf "$temp_dir"' EXIT
new_file=$temp_dir/new
base_file=$temp_dir/base
block_file=$temp_dir/block
backup_file=$temp_dir/backup

if [[ $command_name == validate || $command_name == add ]]; then
  validate_add_target
  if [[ $command_name == validate ]]; then
    exit 0
  fi

  if [[ $command_path != /* || $command_path == *$'\n'* ||
        $command_path == *'"'* || $command_path == *\\* ||
        ! -x $command_path ]]; then
    fail 'COMMAND must be an executable absolute path' 2
  fi

  block_line_ending=lf
  if [[ -s $config_path ]]; then
    IFS= read -r first_line <"$config_path" || true
    if [[ $first_line == *$'\r' ]]; then
      block_line_ending=crlf
    fi
  fi
  write_block "$block_file" "$command_path" "$block_line_ending"
  if [[ $block_state == owned ]]; then
    extract_block "$config_path" "$temp_dir/current-block"
    if command cmp -s "$temp_dir/current-block" "$block_file"; then
      exit 0
    fi
  fi

  if [[ $default_state == present ]]; then
    insert_block "$base_path" "$block_file" "$new_file"
  elif [[ -n $base_path && -s $base_path ]]; then
    command cp "$base_path" "$new_file"
    if [[ -s $new_file ]]; then
      printf '\n' >>"$new_file"
    fi
    printf '%s\n' "$DEFAULT_HEADER" >>"$new_file"
    command cat "$block_file" >>"$new_file"
  else
    printf '%s\n' "$DEFAULT_HEADER" >"$new_file"
    command cat "$block_file" >>"$new_file"
  fi

  replace_contents "$config_path" "$new_file" "$backup_file"
  exit 0
fi

if [[ ! -e $config_path ]]; then
  exit 0
fi
begin_count=$(marker_count "$BEGIN_MARKER" "$config_path")
end_count=$(marker_count "$END_MARKER" "$config_path")
if [[ $begin_count -eq 0 && $end_count -eq 0 ]]; then
  exit 0
fi
if [[ $begin_count -ne 1 || $end_count -ne 1 ]]; then
  fail 'AWS config has incomplete or duplicate project ownership markers'
fi

remove_block "$config_path" "$new_file"
replace_contents "$config_path" "$new_file" "$backup_file"
