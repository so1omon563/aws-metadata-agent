#!/usr/bin/env bash

set -eu
set -o pipefail

readonly BEGIN_MARKER='# aws-metadata-agent user mode: begin'
readonly END_MARKER='# aws-metadata-agent user mode: end'
readonly DEFAULT_HEADER='[default]'
readonly DEFAULT_SECTION_RE='^[[:space:]]*[[]default[]][[:space:]]*([#;].*)?$'

# AWS config maps literal default and shell-quoted named default sections to the
# same profile. Keep this separate from shared-credentials section syntax.
# Match botocore's RawConfigParser section names and shlex-based profile map
# without adding Python to the installed helper's runtime dependencies.
read -r -d '' DEFAULT_CONFIG_AWK <<'AWK' || true
  function has_header(line) {
    return line ~ /^[[:space:]]*\[.*\]/
  }
  function section_header(line, content, indent) {
    # RawConfigParser checks continuation indentation before section syntax.
    # A bracketed line inside a multiline option is still part of that value.
    content = line
    sub(/^[[:space:]]*/, "", content)
    if (content == "" || content ~ /^[#;]/) return 0
    indent = length(line) - length(content)
    if (have_section && have_option && indent > option_indent) return 0
    if (has_header(line)) {
      boundary_indent = have_option ? option_indent : indent
      option_indent = indent
      have_section = 1
      have_option = 0
      return 1
    }
    option_indent = indent
    if (have_section && content ~ /[=:]/) have_option = 1
    return 0
  }
  function is_default(line, name, quote, escaped, started, token, count, second, i, char) {
    if (!has_header(line)) return 0
    name = line
    sub(/^[[:space:]]*\[/, "", name)
    sub(/\][^]]*$/, "", name)
    if (name == "default") return 1
    if (index(name, "profile") != 1) return 0

    # Decode POSIX shlex words, including adjacent quotes and backslashes.
    quote = ""
    escaped = started = count = 0
    token = second = ""
    for (i = 1; i <= length(name); i++) {
      char = substr(name, i, 1)
      if (escaped) {
        if (quote == "\"" && char != "\"" && char != "\\") token = token "\\"
        token = token char
        escaped = 0
      } else if (quote == "\047") {
        if (char == quote) quote = ""
        else token = token char
      } else if (char == "\\") {
        escaped = started = 1
      } else if (quote != "") {
        if (char == quote) quote = ""
        else token = token char
      } else if (char == "\047" || char == "\"") {
        quote = char
        started = 1
      } else if (char == " " || char == "\t" || char == "\r" || char == "\n") {
        if (started) {
          count++
          if (count == 2) second = token
          token = ""
          started = 0
        }
      } else {
        token = token char
        started = 1
      }
    }
    if (escaped || quote != "") return 0
    if (started) {
      count++
      if (count == 2) second = token
    }
    return count == 2 && second == "default"
  }
AWK
readonly DEFAULT_CONFIG_AWK

fail() {
  printf 'aws-metadata-config: %s\n' "$1" >&2
  exit "${2:-1}"
}

marker_count() {
  local marker=$1
  local file=$2

  command awk -v marker="$marker" '
    {
      line = $0
      sub(/\r$/, "", line)
      if (line == marker) {
        count++
      }
    }
    END { print count + 0 }
  ' "$file"
}

replace_contents() {
  local destination=$1
  local source=$2
  local backup=$3
  local existed=false

  if [[ -e $destination ]]; then
    existed=true
    command cp -p "$destination" "$backup"
  else
    umask 077
    : >"$destination"
  fi

  if ! command dd if="$source" of="$destination" 2>/dev/null; then
    if [[ $existed == true ]]; then
      command dd if="$backup" of="$destination" 2>/dev/null || true
    else
      command rm -f "$destination"
    fi
    fail "unable to update $destination"
  fi
}

write_block() {
  local output=$1
  local command_path=$2
  local line_ending=$3

  printf '%s%scredential_process = "%s" _credential-process%s%s%s' \
    "$BEGIN_MARKER" "$line_ending" "$command_path" "$line_ending" \
    "$END_MARKER" "$line_ending" >"$output"
}

insert_block() {
  local input=$1
  local block=$2
  local output=$3

  # Append inside the section, rather than before indented user settings.
  # Otherwise INI parsers fold those settings into credential_process.
  command awk -v block="$block" "$DEFAULT_CONFIG_AWK"'
    function emit_block(indent, line) {
      while ((getline line < block) > 0) {
        # Keep an indented following section from becoming a continuation of
        # our command, without making our command a continuation itself.
        if (line ~ /^credential_process/) printf "%*s", indent, ""
        print line
      }
      close(block)
      inserted = 1
    }
    {
      if (section_header($0)) {
        if (in_default && !inserted) emit_block(boundary_indent)
        in_default = is_default($0)
      }
      print
    }
    END {
      if (in_default && !inserted) emit_block(have_option ? option_indent : 0)
      if (!inserted) exit 2
    }
  ' "$input" >"$output" || fail 'unable to update the default AWS profile'
}

remove_block() {
  local input=$1
  local output=$2

  command awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
    {
      line = $0
      sub(/\r$/, "", line)
    }
    line == begin {
      if (skipping) {
        exit 2
      }
      skipping = 1
      next
    }
    line == end {
      if (!skipping) {
        exit 2
      }
      skipping = 0
      next
    }
    !skipping { print }
    END {
      if (skipping) {
        exit 2
      }
    }
  ' "$input" >"$output" || fail 'owned AWS config block is malformed'
}

default_section_count() {
  local input=$1

  command awk "$DEFAULT_CONFIG_AWK"'
    section_header($0) && is_default($0) { count++ }
    END { print count + 0 }
  ' "$input"
}

default_has_credential_settings() {
  local input=$1

  command awk "$DEFAULT_CONFIG_AWK"'
    section_header($0) {
      in_default = is_default($0)
      next
    }
    in_default {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line ~ /^[#;]/ || line !~ /[=:]/) {
        next
      }
      key = line
      sub(/[[:space:]]*[=:].*/, "", key)
      key = tolower(key)
      gsub(/[[:space:]]/, "", key)
      if (key ~ /^(aws_access_key_id|aws_secret_access_key|aws_session_token|credential_process|credential_source|source_profile|role_arn|web_identity_token_file|sso_.*|login_session)$/) {
        found = 1
        exit
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$input"
}

default_credentials_has_settings() {
  local input=$1

  command awk -v default_section="$DEFAULT_SECTION_RE" '
    /^[[:space:]]*\[/ {
      in_default = ($0 ~ default_section)
      next
    }
    in_default {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line !~ /^[#;]/ && line ~ /[=:]/) {
        found = 1
        exit
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$input"
}

validate_add_target() {
  default_state=missing
  base_path=''
  [[ -e $config_path ]] || return 0

  begin_count=$(marker_count "$BEGIN_MARKER" "$config_path")
  end_count=$(marker_count "$END_MARKER" "$config_path")
  if [[ $begin_count -eq 0 && $end_count -eq 0 ]]; then
    base_path=$config_path
  else
    if [[ $begin_count -ne 1 || $end_count -ne 1 ]]; then
      fail 'AWS config has incomplete or duplicate project ownership markers'
    fi
    remove_block "$config_path" "$base_file"
    base_path=$base_file
  fi

  default_count=$(default_section_count "$base_path")
  if [[ $default_count -gt 1 ]]; then
    fail 'AWS config has duplicate default profiles'
  fi
  if [[ $default_count -eq 1 ]]; then
    default_state=present
    if default_has_credential_settings "$base_path"; then
      fail 'AWS default profile already has a credential provider'
    fi
  fi
}

command_name=${1:-}
config_path=${2:-}
command_path=${3:-}
credentials_path=''

if [[ $command_name != validate && $command_name != add &&
      $command_name != remove ]]; then
  fail 'usage: aws-metadata-config validate CONFIG [CREDENTIALS] | add CONFIG COMMAND [CREDENTIALS] | remove CONFIG' 2
fi
if [[ $command_name == validate ]]; then
  credentials_path=$command_path
  command_path=''
elif [[ $command_name == add ]]; then
  credentials_path=${4:-}
fi
if [[ $config_path != /* || $config_path == *$'\n'* ]]; then
  fail 'CONFIG must be an absolute path' 2
fi
if [[ -L $config_path && ! -e $config_path ]]; then
  fail "refusing to replace dangling symlink $config_path"
fi
if [[ -e $config_path && ! -f $config_path ]]; then
  fail "AWS config is not a regular file: $config_path"
fi
if [[ -e $config_path && ! -r $config_path ]]; then
  fail "AWS config is not readable: $config_path"
fi
if [[ -n $credentials_path ]]; then
  if [[ $credentials_path != /* || $credentials_path == *$'\n'* ]]; then
    fail 'CREDENTIALS must be an absolute path' 2
  fi
  if [[ -e $credentials_path && ! -f $credentials_path ]]; then
    fail "AWS credentials are not a regular file: $credentials_path"
  fi
  if [[ -e $credentials_path && ! -r $credentials_path ]]; then
    fail "AWS credentials are not readable: $credentials_path"
  fi
  if [[ -e $credentials_path ]] &&
     default_credentials_has_settings "$credentials_path"; then
    fail 'AWS credentials file already configures the default profile'
  fi
fi

temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/aws-metadata-config.XXXXXX")
trap 'rm -rf "$temp_dir"' EXIT
new_file=$temp_dir/new
base_file=$temp_dir/base
block_file=$temp_dir/block
backup_file=$temp_dir/backup

if [[ $command_name == validate || $command_name == add ]]; then
  validate_add_target
  if [[ $command_name == validate ]]; then
    exit 0
  fi

  if [[ $command_path != /* || $command_path == *$'\n'* ||
        $command_path == *'"'* || $command_path == *\\* ||
        ! -x $command_path ]]; then
    fail 'COMMAND must be an executable absolute path' 2
  fi

  line_ending=$'\n'
  if [[ -s $config_path ]]; then
    IFS= read -r first_line <"$config_path" || true
    if [[ $first_line == *$'\r' ]]; then
      line_ending=$'\r\n'
    fi
  fi
  write_block "$block_file" "$command_path" "$line_ending"

  if [[ $default_state == present ]]; then
    insert_block "$base_path" "$block_file" "$new_file"
  elif [[ -n $base_path && -s $base_path ]]; then
    command cp "$base_path" "$new_file"
    if [[ -s $new_file ]]; then
      printf '%s' "$line_ending" >>"$new_file"
    fi
    printf '%s%s' "$DEFAULT_HEADER" "$line_ending" >>"$new_file"
    command cat "$block_file" >>"$new_file"
  else
    printf '%s%s' "$DEFAULT_HEADER" "$line_ending" >"$new_file"
    command cat "$block_file" >>"$new_file"
  fi

  if ! command cmp -s "$config_path" "$new_file"; then
    replace_contents "$config_path" "$new_file" "$backup_file"
  fi
  exit 0
fi

if [[ ! -e $config_path ]]; then
  exit 0
fi
begin_count=$(marker_count "$BEGIN_MARKER" "$config_path")
end_count=$(marker_count "$END_MARKER" "$config_path")
if [[ $begin_count -eq 0 && $end_count -eq 0 ]]; then
  exit 0
fi
if [[ $begin_count -ne 1 || $end_count -ne 1 ]]; then
  fail 'AWS config has incomplete or duplicate project ownership markers'
fi

remove_block "$config_path" "$new_file"
replace_contents "$config_path" "$new_file" "$backup_file"
